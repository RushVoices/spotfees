    "@solana/web3.js": "^1.98.0",
    "bn.js": "^5.2.1",
    "buffer": "^6.0.3",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/three": "^0.169.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-node-polyfills": "^0.22.0"
  }
}
