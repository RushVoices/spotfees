# Copy to .env and fill in. Without VITE_RPC_URL and VITE_TREASURY the site
# runs as a preview with sample data.

# "devnet" or "mainnet-beta"
VITE_CLUSTER=devnet
# Your RPC endpoint (Helius, Triton, QuickNode...). Public endpoints rate-limit getProgramAccounts.
VITE_RPC_URL=
# The Stacks program id (printed by scripts/set-program-id.sh)
VITE_STACKS_PROGRAM_ID=
# Treasury wallet that receives the 2% protocol fee (must match init-config.ts --treasury)
VITE_TREASURY=
# Only needed for Meteora launches (scripts/create-meteora-config.ts)
VITE_METEORA_CONFIG=

# Server-side, for /api/upload (set these in Vercel, not in the browser bundle)
PINATA_JWT=
# Optional dedicated gateway, e.g. yourname.mypinata.cloud
PINATA_GATEWAY=
